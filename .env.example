NODE_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=3001
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/distrilux_portal?schema=public
ERP_API_URL=
ERP_API_KEY=
# Signs session tokens. Use a random value with at least 32 characters.
SESSION_SECRET=replace-with-a-random-value-of-at-least-32-characters
# Number of reverse proxies in front of the API (0 when it is reached directly).
TRUST_PROXY=0

# Password of every development user created by the seed (pnpm db:seed).
SEED_PASSWORD=replace-with-a-development-password
