NODE_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=3001
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/distrilux_portal?schema=public
ERP_API_URL=
ERP_API_KEY=
# Server-only model keys for the triage agent. Leave commented until you have them;
# an empty value fails startup.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# IA-01 spike only (scripts/agent-spike): gemini or anthropic. Required to run
# with --execute; the server never reads it.
# AGENT_SPIKE_PROVIDER=
