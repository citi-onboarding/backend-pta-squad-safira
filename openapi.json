{
  "openapi": "3.1.0",
  "info": {
    "title": "DistriLux Portal de Pedidos API",
    "version": "0.1.0",
    "description": "Contract generated from the same Zod schemas used at runtime."
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local development"
    }
  ],
  "components": {
    "schemas": {
      "CurrentUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "papel": {
            "type": "string",
            "enum": [
              "VENDEDOR",
              "GERENTE",
              "FINANCEIRO",
              "ADMINISTRADOR"
            ]
          }
        },
        "required": [
          "id",
          "nome",
          "papel"
        ],
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "papel": {
            "type": "string",
            "enum": [
              "VENDEDOR",
              "GERENTE",
              "FINANCEIRO",
              "ADMINISTRADOR"
            ]
          },
          "ativo": {
            "type": "boolean"
          },
          "codigoVendedor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "nome",
          "email",
          "papel",
          "ativo",
          "codigoVendedor"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign in with email and password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "senha": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "email",
                  "senha"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in. Sets the HttpOnly session cookie.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "nome": {
                      "type": "string"
                    },
                    "papel": {
                      "type": "string",
                      "enum": [
                        "VENDEDOR",
                        "GERENTE",
                        "FINANCEIRO",
                        "ADMINISTRADOR"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "nome",
                    "papel"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid email or password"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign out and remove the session cookie",
        "responses": {
          "204": {
            "description": "Signed out"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Get the signed-in user",
        "responses": {
          "200": {
            "description": "Signed-in user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "nome": {
                      "type": "string"
                    },
                    "papel": {
                      "type": "string",
                      "enum": [
                        "VENDEDOR",
                        "GERENTE",
                        "FINANCEIRO",
                        "ADMINISTRADOR"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "nome",
                    "papel"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "No valid session"
          }
        }
      }
    },
    "/users": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "List users",
        "responses": {
          "200": {
            "description": "Users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "nome": {
                        "type": "string"
                      },
                      "email": {
                        "type": "string"
                      },
                      "papel": {
                        "type": "string",
                        "enum": [
                          "VENDEDOR",
                          "GERENTE",
                          "FINANCEIRO",
                          "ADMINISTRADOR"
                        ]
                      },
                      "ativo": {
                        "type": "boolean"
                      },
                      "codigoVendedor": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "nome",
                      "email",
                      "papel",
                      "ativo",
                      "codigoVendedor"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          },
          "401": {
            "description": "No valid session"
          },
          "403": {
            "description": "Only the Administrator role may manage users"
          }
        }
      },
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Create a user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": {
                    "type": "string",
                    "minLength": 1
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "senha": {
                    "type": "string",
                    "minLength": 1
                  },
                  "papel": {
                    "type": "string",
                    "enum": [
                      "VENDEDOR",
                      "GERENTE",
                      "FINANCEIRO",
                      "ADMINISTRADOR"
                    ]
                  },
                  "codigoVendedor": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  }
                },
                "required": [
                  "nome",
                  "email",
                  "senha",
                  "papel"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "nome": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    },
                    "papel": {
                      "type": "string",
                      "enum": [
                        "VENDEDOR",
                        "GERENTE",
                        "FINANCEIRO",
                        "ADMINISTRADOR"
                      ]
                    },
                    "ativo": {
                      "type": "boolean"
                    },
                    "codigoVendedor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "nome",
                    "email",
                    "papel",
                    "ativo",
                    "codigoVendedor"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "No valid session"
          },
          "403": {
            "description": "Only the Administrator role may manage users"
          },
          "409": {
            "description": "Email or salesperson code already in use"
          }
        }
      }
    },
    "/users/{id}": {
      "patch": {
        "tags": [
          "Users"
        ],
        "summary": "Change a user's name, role, or active flag",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": {
                    "type": "string",
                    "minLength": 1
                  },
                  "papel": {
                    "type": "string",
                    "enum": [
                      "VENDEDOR",
                      "GERENTE",
                      "FINANCEIRO",
                      "ADMINISTRADOR"
                    ]
                  },
                  "ativo": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "nome": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    },
                    "papel": {
                      "type": "string",
                      "enum": [
                        "VENDEDOR",
                        "GERENTE",
                        "FINANCEIRO",
                        "ADMINISTRADOR"
                      ]
                    },
                    "ativo": {
                      "type": "boolean"
                    },
                    "codigoVendedor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "nome",
                    "email",
                    "papel",
                    "ativo",
                    "codigoVendedor"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "No valid session"
          },
          "403": {
            "description": "Only the Administrator role may manage users"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/users/{id}/redefinir-senha": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Set a new password for a user",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "senha": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "senha"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Password changed"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "No valid session"
          },
          "403": {
            "description": "Only the Administrator role may manage users"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    }
  },
  "webhooks": {}
}
