{
  "openapi": "3.1.0",
  "info": {
    "title": "DistriLux Portal de Pedidos API",
    "version": "0.1.0",
    "description": "Contract generated from the same Zod schemas used at runtime."
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local development"
    }
  ],
  "components": {
    "schemas": {
      "CurrentUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "papel": {
            "type": "string",
            "enum": [
              "VENDEDOR",
              "GERENTE",
              "FINANCEIRO",
              "ADMINISTRADOR"
            ]
          }
        },
        "required": [
          "id",
          "nome",
          "papel"
        ],
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "papel": {
            "type": "string",
            "enum": [
              "VENDEDOR",
              "GERENTE",
              "FINANCEIRO",
              "ADMINISTRADOR"
            ]
          },
          "ativo": {
            "type": "boolean"
          },
          "codigoVendedor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "nome",
          "email",
          "papel",
          "ativo",
          "codigoVendedor"
        ],
        "additionalProperties": false
      },
      "CustomerPage": {
        "type": "object",
        "properties": {
          "itens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomerListItem"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of clients that match the search in the portfolio."
          },
          "pagina": {
            "type": "integer",
            "minimum": 1
          },
          "tamanhoPagina": {
            "type": "number",
            "enum": [
              60
            ]
          }
        },
        "required": [
          "itens",
          "total",
          "pagina",
          "tamanhoPagina"
        ],
        "additionalProperties": false
      },
      "CustomerListItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "codigoErp": {
            "type": "string",
            "example": "C0044"
          },
          "razaoSocial": {
            "type": "string"
          },
          "cnpj": {
            "type": "string",
            "description": "Digits only.",
            "example": "11222333000181"
          },
          "cidade": {
            "type": "string"
          },
          "uf": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "status": {
            "type": "string",
            "enum": [
              "ATIVO",
              "BLOQUEADO",
              "INATIVO"
            ]
          },
          "codigoVendedor": {
            "type": "string",
            "example": "V01"
          },
          "vendedorNome": {
            "type": [
              "string",
              "null"
            ],
            "example": "Patrícia Lima"
          },
          "limiteDisponivelCentavos": {
            "type": "integer",
            "description": "Credit limit minus unpaid ERP receivables (RN-01). May be negative."
          }
        },
        "required": [
          "id",
          "codigoErp",
          "razaoSocial",
          "cnpj",
          "cidade",
          "uf",
          "status",
          "codigoVendedor",
          "vendedorNome",
          "limiteDisponivelCentavos"
        ],
        "additionalProperties": false
      },
      "CustomerProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "codigoErp": {
            "type": "string"
          },
          "razaoSocial": {
            "type": "string"
          },
          "cnpj": {
            "type": "string"
          },
          "cidade": {
            "type": "string"
          },
          "uf": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "segmento": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ATIVO",
              "BLOQUEADO",
              "INATIVO"
            ]
          },
          "codigoVendedor": {
            "type": "string",
            "example": "V01"
          },
          "vendedorNome": {
            "type": [
              "string",
              "null"
            ],
            "example": "Patrícia Lima"
          },
          "credito": {
            "$ref": "#/components/schemas/CreditPosition"
          },
          "titulosVencidos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OverdueReceivable"
            },
            "description": "Oldest due date first."
          },
          "ultimoPedidoEm": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Always null until orders (BACK-06) or the history load (DATA-03 and DATA-04) exist."
          },
          "ultimaSincronizacao": {
            "type": "object",
            "properties": {
              "clientesEm": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "End time of the last successful client sync."
              },
              "titulosEm": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "End time of the last successful receivables sync."
              }
            },
            "required": [
              "clientesEm",
              "titulosEm"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "codigoErp",
          "razaoSocial",
          "cnpj",
          "cidade",
          "uf",
          "segmento",
          "status",
          "codigoVendedor",
          "vendedorNome",
          "credito",
          "titulosVencidos",
          "ultimoPedidoEm",
          "ultimaSincronizacao"
        ],
        "additionalProperties": false
      },
      "CreditPosition": {
        "type": "object",
        "properties": {
          "limiteCreditoCentavos": {
            "type": "integer"
          },
          "emAbertoCentavos": {
            "type": "integer",
            "minimum": 0,
            "description": "Unpaid ERP receivables due today or later."
          },
          "vencidoCentavos": {
            "type": "integer",
            "minimum": 0,
            "description": "Unpaid ERP receivables due before today."
          },
          "limiteDisponivelCentavos": {
            "type": "integer",
            "description": "limiteCreditoCentavos − emAbertoCentavos − vencidoCentavos (RN-01). May be negative."
          }
        },
        "required": [
          "limiteCreditoCentavos",
          "emAbertoCentavos",
          "vencidoCentavos",
          "limiteDisponivelCentavos"
        ],
        "additionalProperties": false
      },
      "OverdueReceivable": {
        "type": "object",
        "properties": {
          "numero": {
            "type": "string"
          },
          "parcela": {
            "type": "integer",
            "minimum": 1
          },
          "valorCentavos": {
            "type": "integer"
          },
          "vencimento": {
            "type": "string",
            "format": "date",
            "example": "2026-11-17"
          },
          "diasEmAtraso": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "numero",
          "parcela",
          "valorCentavos",
          "vencimento",
          "diasEmAtraso"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign in with email and password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "senha": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "email",
                  "senha"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in. Sets the HttpOnly session cookie.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "nome": {
                      "type": "string"
                    },
                    "papel": {
                      "type": "string",
                      "enum": [
                        "VENDEDOR",
                        "GERENTE",
                        "FINANCEIRO",
                        "ADMINISTRADOR"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "nome",
                    "papel"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid email or password"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign out and remove the session cookie",
        "responses": {
          "204": {
            "description": "Signed out"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Get the signed-in user",
        "responses": {
          "200": {
            "description": "Signed-in user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "nome": {
                      "type": "string"
                    },
                    "papel": {
                      "type": "string",
                      "enum": [
                        "VENDEDOR",
                        "GERENTE",
                        "FINANCEIRO",
                        "ADMINISTRADOR"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "nome",
                    "papel"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "No valid session"
          }
        }
      }
    },
    "/clientes": {
      "get": {
        "tags": [
          "Customers"
        ],
        "summary": "Search clients of the signed-in user's portfolio",
        "description": "A salesperson only finds clients of their own portfolio (RN-08); the sales manager and the finance role find every client. At most 60 clients per page, ordered by company name.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "maxLength": 100,
              "description": "Part of the company name, the ERP code, or the CNPJ (with or without punctuation). Empty returns the whole portfolio.",
              "example": "11.222.333/0001-81"
            },
            "required": false,
            "description": "Part of the company name, the ERP code, or the CNPJ (with or without punctuation). Empty returns the whole portfolio.",
            "name": "busca",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "description": "Page number, starting at 1.",
              "example": 1
            },
            "required": false,
            "description": "Page number, starting at 1.",
            "name": "pagina",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "One page of matching clients",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid page or search term"
          },
          "401": {
            "description": "No valid session"
          },
          "403": {
            "description": "The role has no access to clients (Administrator, or a salesperson without a salesperson code)"
          }
        }
      }
    },
    "/clientes/{id}": {
      "get": {
        "tags": [
          "Customers"
        ],
        "summary": "Get a client's profile and credit position",
        "description": "A client of another portfolio answers 404, the same as a client that does not exist.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Client profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerProfile"
                }
              }
            }
          },
          "400": {
            "description": "Malformed client id"
          },
          "401": {
            "description": "No valid session"
          },
          "403": {
            "description": "The role has no access to clients (Administrator, or a salesperson without a salesperson code)"
          },
          "404": {
            "description": "Client not found in the user's portfolio"
          }
        }
      }
    },
    "/users": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "List users",
        "responses": {
          "200": {
            "description": "Users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "nome": {
                        "type": "string"
                      },
                      "email": {
                        "type": "string"
                      },
                      "papel": {
                        "type": "string",
                        "enum": [
                          "VENDEDOR",
                          "GERENTE",
                          "FINANCEIRO",
                          "ADMINISTRADOR"
                        ]
                      },
                      "ativo": {
                        "type": "boolean"
                      },
                      "codigoVendedor": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "nome",
                      "email",
                      "papel",
                      "ativo",
                      "codigoVendedor"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          },
          "401": {
            "description": "No valid session"
          },
          "403": {
            "description": "Only the Administrator role may manage users"
          }
        }
      },
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Create a user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": {
                    "type": "string",
                    "minLength": 1
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "senha": {
                    "type": "string",
                    "minLength": 8
                  },
                  "papel": {
                    "type": "string",
                    "enum": [
                      "VENDEDOR",
                      "GERENTE",
                      "FINANCEIRO",
                      "ADMINISTRADOR"
                    ]
                  },
                  "codigoVendedor": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  }
                },
                "required": [
                  "nome",
                  "email",
                  "senha",
                  "papel"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "nome": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    },
                    "papel": {
                      "type": "string",
                      "enum": [
                        "VENDEDOR",
                        "GERENTE",
                        "FINANCEIRO",
                        "ADMINISTRADOR"
                      ]
                    },
                    "ativo": {
                      "type": "boolean"
                    },
                    "codigoVendedor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "nome",
                    "email",
                    "papel",
                    "ativo",
                    "codigoVendedor"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "No valid session"
          },
          "403": {
            "description": "Only the Administrator role may manage users"
          },
          "409": {
            "description": "Email or salesperson code already in use"
          }
        }
      }
    },
    "/users/{id}": {
      "patch": {
        "tags": [
          "Users"
        ],
        "summary": "Change a user's name, role, active flag, or salesperson code",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": {
                    "type": "string",
                    "minLength": 1
                  },
                  "papel": {
                    "type": "string",
                    "enum": [
                      "VENDEDOR",
                      "GERENTE",
                      "FINANCEIRO",
                      "ADMINISTRADOR"
                    ]
                  },
                  "ativo": {
                    "type": "boolean"
                  },
                  "codigoVendedor": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "nome": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    },
                    "papel": {
                      "type": "string",
                      "enum": [
                        "VENDEDOR",
                        "GERENTE",
                        "FINANCEIRO",
                        "ADMINISTRADOR"
                      ]
                    },
                    "ativo": {
                      "type": "boolean"
                    },
                    "codigoVendedor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "nome",
                    "email",
                    "papel",
                    "ativo",
                    "codigoVendedor"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "No valid session"
          },
          "403": {
            "description": "Only the Administrator role may manage users"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/users/{id}/redefinir-senha": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Set a new password for a user",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "senha": {
                    "type": "string",
                    "minLength": 8
                  }
                },
                "required": [
                  "senha"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Password changed"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "No valid session"
          },
          "403": {
            "description": "Only the Administrator role may manage users"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    }
  },
  "webhooks": {}
}
